@@ -0,0 +1,174 @@
+"""Iris-3B model adapter (pixel-space hybrid MMDiT, speridlabs/iris-3b).
+
+Authored from the released ``speridlabs/iris-3b`` ``model.safetensors`` header (639 tensors,
+float32) and its source (``iris3b/models/dit.py``, ``iris3b/nn/attention.py``). No VAE:
+the network outputs RGB pixels through a small pixel head.
+
+One ``blocks`` list holds both block kinds: ``blocks.0-7`` are dual-stream (MMDiT) blocks
+with separate image (``_x``) and text (``_y``) weights, ``blocks.8-23`` are single-stream
+blocks. Every Linear is ``hidden -> hidden`` (2560) except GQA k/v (640 out: 5 KV heads x
+128) and the SwiGLU MLP (``w1``/``w3``: 2560 -> 6826, ``w2``: 6826 -> 2560). Attention
+output projections carry a bias, which stays high precision beside the quantized weight.
+
+Artifacts keep the original bare key names, so they load in ComfyUI through custom nodes
+that build Iris from ``comfy.ops`` and detect per-layer quantization (e.g. envy-ai's
+ComfyUI-Iris, ``comfy.utils.detect_layer_quantization(sd, "")``). Stock ComfyUI has no
+Iris model.
+
+Default selection follows the community INT4 ConvRot profile: quantize the image side of
+the dual-stream blocks and all single-stream blocks (attention projections, content gates
+and MLP ``w1``/``w3``); keep the text side, every ``w2`` (in-features 6826 is not a
+multiple of the MXFP8/NVFP4 block sizes or of 16 for the FP8/INT8 matmul kernels), the
+shared modulation cores, the text adapter, the embedders and the pixel head high precision.
+"""
+
+from __future__ import annotations
+
+from comfy_quants.comfy.stock_dit_contract import stock_dit_artifact_contract_metadata
+from comfy_quants.core.policy import QuantPolicy
+from comfy_quants.model_adapters.base import ModelSource
+from comfy_quants.model_adapters.stock_dit_contract import (
+    BlockGroup,
+    StockDitContract,
+    build_stock_dit_graph,
+    kept_component,
+    linear,
+    summarize_stock_dit_graph,
+)
+
+CONTRACT_SCHEMA_VERSION = "iris_static_contract.v1"
+
+_HIDDEN = 2560
+_HEAD_DIM = 128
+_NUM_HEADS = 20
+_NUM_KV_HEADS = 5
+_MLP = 6826  # int(2560 * 8/3), SwiGLU hidden
+_DUAL_BLOCKS = 8
+_SINGLE_BLOCKS = 16
+_PIXEL_BLOCKS = 4
+
+# Image side of the dual blocks + all single blocks, MLP down projections excluded.
+DEFAULT_INCLUDE = ("blocks.*",)
+DEFAULT_EXCLUDE = (
+    "blocks.*.attn.*_y",
+    "blocks.*.attn_gate_y",
+    "blocks.*.mlp_y.*",
+    "blocks.*.mlp_x.w2",
+    "blocks.*.mlp.w2",
+)
+
+
+def _dims() -> dict[str, int]:
+    return {
+        "X": _HIDDEN,  # 2560
+        "KV": _NUM_KV_HEADS * _HEAD_DIM,  # 640 (GQA k/v)
+        "MLP": _MLP,  # 6826
+    }
+
+
+def _swiglu(prefix: str) -> tuple:
+    return (
+        linear(f"{prefix}.w1", "MLP", "X", module_type="SwiGLULinear"),
+        linear(f"{prefix}.w2", "X", "MLP", notes="in_features 6826: not block-format aligned"),
+        linear(f"{prefix}.w3", "MLP", "X", module_type="SwiGLULinear"),
+    )
+
+
+def _dual_block_modules() -> tuple:
+    p = "blocks.{block}"
+    modules = []
+    for stream in ("x", "y"):  # x = image tokens, y = text tokens
+        modules += [
+            linear(f"{p}.attn.q_proj_{stream}", "X", "X"),
+            linear(f"{p}.attn.k_proj_{stream}", "KV", "X"),
+            linear(f"{p}.attn.v_proj_{stream}", "KV", "X"),
+            linear(f"{p}.attn.proj_{stream}", "X", "X"),
+            linear(f"{p}.attn_gate_{stream}", "X", "X", module_type="GateLinear"),
+            *_swiglu(f"{p}.mlp_{stream}"),
+        ]
+    return tuple(modules)
+
+
+def _single_block_modules() -> tuple:
+    p = "blocks.{block}"
+    return (
+        linear(f"{p}.q_proj", "X", "X"),
+        linear(f"{p}.k_proj", "KV", "X"),
+        linear(f"{p}.v_proj", "KV", "X"),
+        linear(f"{p}.attn_gate", "X", "X", module_type="GateLinear"),
+        linear(f"{p}.attn_proj", "X", "X"),
+        *_swiglu(f"{p}.mlp"),
+    )
+
+
+def _extra_components() -> tuple:
+    return (
+        kept_component("s_embedder", "PatchEmbedder", "transformer", "16x16 pixel patch embedding kept high precision"),
+        kept_component("t_embedder", "TimestepEmbedder", "transformer", "timestep embedding kept high precision"),
+        kept_component("y_embedder", "LayerwiseTextEmbedder", "transformer", "Qwen3-VL text adapter kept high precision"),
+        kept_component("y_pos_embedding", "Parameter", "transformer", "text position embedding kept high precision"),
+        kept_component("modulation_cores", "SharedModulation", "transformer", "shared adaLN cores kept high precision"),
+        kept_component("pixel_embedder", "Linear", "transformer", "pixel head input kept high precision"),
+        kept_component("pixel_blocks", "PixelBlock", "transformer", "pixel head kept high precision"),
+        kept_component("final_layer", "FinalLayer", "transformer", "RGB output layer kept high precision"),
+    )
+
+
+def build_iris_static_contract() -> StockDitContract:
+    return StockDitContract(
+        family="iris",
+        schema_version=CONTRACT_SCHEMA_VERSION,
+        preferred_format="fp8_e4m3",
+        dims=_dims(),
+        block_groups=(
+            BlockGroup(prefix="blocks", count=_DUAL_BLOCKS, modules=_dual_block_modules()),
+            BlockGroup(prefix="blocks", count=_SINGLE_BLOCKS, modules=_single_block_modules(), start=_DUAL_BLOCKS),
+        ),
+        extra_components=_extra_components(),
+        metadata={
+            "export_name": "Iris-3B",
+            "architecture": "iris_hybrid_mmdit_pixel",
+            "hidden_size": _HIDDEN,
+            "num_heads": _NUM_HEADS,
+            "num_kv_heads": _NUM_KV_HEADS,
+            "head_dim": _HEAD_DIM,
+            "mlp_hidden": _MLP,
+            "dual_blocks": _DUAL_BLOCKS,
+            "single_blocks": _SINGLE_BLOCKS,
+            "pixel_blocks": _PIXEL_BLOCKS,
+            "text_encoder": "qwen3vl_4b",
+            "vae": None,
+            "supported_model_ids": ("speridlabs/iris-3b",),
+        },
+    )
+
+
+class IrisAdapter:
+    """Adapter for Iris-3B text-to-image (and its same-architecture depth/upscaler fine-tunes)."""
+
+    family = "iris"
+    supported_model_ids = ["speridlabs/iris-3b"]
+
+    def inspect(self, source: ModelSource):
+        contract = build_iris_static_contract()
+        graph = build_stock_dit_graph(
+            contract,
+            source,
+            artifact_metadata=stock_dit_artifact_contract_metadata("iris"),
+        )
+        return summarize_stock_dit_graph(graph, self.__class__.__name__), graph
+
+    def default_policy(self, target_dtype: str = "fp8_e4m3") -> QuantPolicy:
+        return QuantPolicy(
+            name="iris_default",
+            algorithm="fp8_static",
+            target_dtype=target_dtype,
+            include=list(DEFAULT_INCLUDE),
+            exclude=list(DEFAULT_EXCLUDE),
+            keep_components=["text_encoder"],
+        )
+
+
+from comfy_quants.registry.global_registry import registry  # noqa: E402
+
+registry.register_adapter(IrisAdapter())
