diff --git a/tests/unit/test_iris_contract.py b/tests/unit/test_iris_contract.py
new file mode 100644
index 0000000..fe4b70b
--- /dev/null
+++ b/tests/unit/test_iris_contract.py
@@ -0,0 +1,131 @@
+import unittest
+from pathlib import Path
+
+from comfy_quants.algorithms.tensor_index import TensorIndexOptions, build_quant_tensor_index
+from comfy_quants.core.config import load_quant_config
+from comfy_quants.model_adapters.base import ModelSource
+from comfy_quants.model_adapters.iris import build_iris_static_contract
+from comfy_quants.model_adapters.registry import get_adapter
+from comfy_quants.model_adapters.stock_dit_contract import BlockGroup
+
+CONFIGS = Path(__file__).resolve().parents[2] / "configs"
+IRIS_CONFIGS = {
+    "iris_3b_fp8.yaml": ("fp8_e4m3", "per_tensor", None, None),
+    "iris_3b_fp8_e5m2.yaml": ("fp8_e5m2", "per_tensor", None, None),
+    "iris_3b_mxfp8.yaml": ("mxfp8", "block", "in_features", 32),
+    "iris_3b_nvfp4.yaml": ("nvfp4", "block", "in_features", 16),
+    "iris_3b_int8_tensorwise.yaml": ("int8_tensorwise", "per_channel", "out_features", None),
+}
+
+
+def _graph():
+    _insp, graph = get_adapter("iris").inspect(ModelSource(family="iris", model_id="speridlabs/iris-3b"))
+    return graph
+
+
+def _index(target_dtype, granularity, axis, block_size=None, include=None, exclude=None):
+    adapter = get_adapter("iris")
+    policy = adapter.default_policy(target_dtype)
+    if include is not None:
+        policy.include = include
+    if exclude is not None:
+        policy.exclude = exclude
+    return build_quant_tensor_index(
+        _graph(),
+        policy,
+        TensorIndexOptions(
+            algorithm=policy.algorithm,
+            algorithm_version="0.1.0",
+            target_dtype=target_dtype,
+            scale_granularity=granularity,
+            scale_axis=axis,
+            scale_method="amax",
+            rounding="nearest_even",
+            compatibility_level="L2",
+            scale_block_size=block_size,
+            scale_dtype="float8_e4m3fn" if granularity == "block" else "fp32",
+        ),
+    )
+
+
+class TestIrisContract(unittest.TestCase):
+    def test_contract(self):
+        c = build_iris_static_contract()
+        self.assertEqual(c.family, "iris")
+        self.assertEqual(c.schema_version, "iris_static_contract.v1")
+        self.assertEqual([(g.prefix, g.start, g.count) for g in c.block_groups], [("blocks", 0, 8), ("blocks", 8, 16)])
+        self.assertEqual(c.dimensions(), {"X": 2560, "KV": 640, "MLP": 6826})
+
+    def test_block_group_offset(self):
+        group = BlockGroup(prefix="blocks", count=16, modules=(), start=8)
+        self.assertEqual(list(group.indices), list(range(8, 24)))
+        self.assertEqual(group.summary_key, "blocks[8:24]")
+        self.assertEqual(BlockGroup(prefix="layers", count=3, modules=()).summary_key, "layers")
+        summary = _graph().metadata["model_contract"]["block_groups"]
+        self.assertEqual(summary, {"blocks": 8, "blocks[8:24]": 16})
+
+    def test_graph_matches_released_checkpoint(self):
+        # Names and shapes from the speridlabs/iris-3b model.safetensors header.
+        by_name = {t.name: t.shape for m in _graph().modules for t in m.tensors}
+        self.assertEqual(len(by_name), 8 * 16 + 16 * 8)  # every 2D Linear weight of blocks.0-23
+        expected = {
+            "blocks.0.attn.q_proj_x.weight": [2560, 2560],
+            "blocks.0.attn.k_proj_x.weight": [640, 2560],
+            "blocks.7.attn.v_proj_y.weight": [640, 2560],
+            "blocks.3.attn.proj_y.weight": [2560, 2560],
+            "blocks.0.attn_gate_x.weight": [2560, 2560],
+            "blocks.0.mlp_x.w1.weight": [6826, 2560],
+            "blocks.0.mlp_y.w2.weight": [2560, 6826],
+            "blocks.8.q_proj.weight": [2560, 2560],
+            "blocks.8.k_proj.weight": [640, 2560],
+            "blocks.23.attn_gate.weight": [2560, 2560],
+            "blocks.23.attn_proj.weight": [2560, 2560],
+            "blocks.23.mlp.w3.weight": [6826, 2560],
+        }
+        for name, shape in expected.items():
+            self.assertEqual(by_name[name], shape, name)
+        self.assertNotIn("blocks.8.attn.q_proj_x.weight", by_name)
+        self.assertNotIn("blocks.7.q_proj.weight", by_name)
+        self.assertNotIn("blocks.24.q_proj.weight", by_name)
+
+    def test_default_selection_is_image_side_without_w2(self):
+        idx = _index("fp8_e4m3", "per_tensor", None)
+        sel = {row["name"] for row in idx["tensors"]}
+        # dual: q/k/v/proj/gate/w1/w3 of the image stream; single: q/k/v/gate/proj/w1/w3
+        self.assertEqual(len(sel), 8 * 7 + 16 * 7)
+        self.assertIn("blocks.0.attn.q_proj_x.weight", sel)
+        self.assertIn("blocks.0.attn_gate_x.weight", sel)
+        self.assertIn("blocks.0.mlp_x.w3.weight", sel)
+        self.assertIn("blocks.8.attn_proj.weight", sel)
+        for name in sel:
+            self.assertNotIn("_y.", name)
+            self.assertNotIn(".w2.", name)
+            self.assertNotIn("modulation_cores", name)
+            self.assertNotIn("pixel", name)
+            self.assertNotIn("y_embedder", name)
+        by_name = {t.name: t.shape for m in _graph().modules for t in m.tensors}
+        for name in sel:
+            self.assertEqual(by_name[name][1] % 256, 0, name)  # MXFP8, NVFP4 and ConvRot aligned
+
+    def test_text_side_can_be_opted_in(self):
+        idx = _index("fp8_e4m3", "per_tensor", None, exclude=["blocks.*.mlp_x.w2", "blocks.*.mlp_y.w2", "blocks.*.mlp.w2"])
+        self.assertEqual(len(idx["tensors"]), 8 * 14 + 16 * 7)
+
+    def test_configs_build(self):
+        for config_name, (target_dtype, granularity, axis, block_size) in IRIS_CONFIGS.items():
+            with self.subTest(config=config_name):
+                cfg = load_quant_config(CONFIGS / config_name)
+                self.assertEqual(cfg.model.family, "iris")
+                self.assertEqual(cfg.quant.target_dtype, target_dtype)
+                self.assertEqual(cfg.quant.scale.granularity, granularity)
+                idx = _index(target_dtype, granularity, axis, block_size,
+                             include=cfg.quant.modules["include"], exclude=cfg.quant.modules["exclude"])
+                self.assertEqual(idx["format"]["name"], target_dtype)
+                self.assertEqual(len(idx["tensors"]), 168)
+                if block_size:
+                    for row in idx["tensors"]:
+                        self.assertEqual(row["scale"]["block_size"], block_size)
+
+
+if __name__ == "__main__":
+    unittest.main()
